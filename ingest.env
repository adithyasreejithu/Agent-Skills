# Where the ingest skill keeps its files for THIS repo. Paths are relative to the repo root.
# Precedence: CLI --home > environment > this file > ~/.config/ingest/.env > built-in defaults.
# No secrets here: API keys stay in ~/.config/watch/.env.
INGEST_HOME=queue
INGEST_RESEARCH_DIR=research
INGEST_RAW_DIR=watch-output/video-data

INGEST_TESTING=1

INGEST_LABELS_DIR=training/labels
